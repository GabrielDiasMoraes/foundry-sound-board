{
  "id": "foundry-sound-board",
  "title": "Foundry Sound Board",
  "description": "GM-controlled synced YouTube music channels, effects, saved playlists and a Streamdeck-style sound board with proportional volume.",
  "version": "0.3.0",
  "authors": [
    {
      "name": "Gabriel Dias Moraes",
      "url": "https://github.com/GabrielDiasMoraes"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "recommends": [
      {
        "id": "popout",
        "type": "module",
        "reason": "Pop the player out into its own browser window"
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/sound-board.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "socket": true,
  "url": "https://github.com/GabrielDiasMoraes/foundry-sound-board",
  "manifest": "https://github.com/GabrielDiasMoraes/foundry-sound-board/releases/latest/download/module.json",
  "download": "https://github.com/GabrielDiasMoraes/foundry-sound-board/releases/download/v0.3.0/module.zip",
  "readme": "https://github.com/GabrielDiasMoraes/foundry-sound-board#readme",
  "bugs": "https://github.com/GabrielDiasMoraes/foundry-sound-board/issues",
  "license": "LICENSE",
